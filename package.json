    "oxlint": "oxlint .",
    "lint": "npm run oxlint && npm run stylelint",
    "format:test": "oxfmt --check \"**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt --write \"**/*.{ts,tsx,css}\"",
    "release:major": "yarn version major",
    "release:minor": "yarn version minor",
    "release:patch": "yarn version patch",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "stylelint": "stylelint '**/*.css' --cache",
    "test": "npx next typegen && npm run format:test && npm run lint && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "version": "1.0.0",
  "resolutions": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
